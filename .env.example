# NMO 皮肤站凭据（https://skin.nmo.net.cn/，需 @smail.nju.edu.cn 或 @nju.edu.cn 注册并完成邮箱验证）
MC_SKIN_EMAIL=your_id@smail.nju.edu.cn
MC_SKIN_PASSWORD=your_skin_station_password

# 默认使用的 Bot 角色名（可选；多角色账号登录 MC API 时通过角色名指定选定角色）
MC_BOT_USERNAME=

# MC 控制接口地址（校园网直连低延迟，默认推荐；校外备选公网隧道 https://mc-api.windywindie.top/api/v1）
MC_API_BASE_URL=https://apiin.nmo.net.cn/api/v1
MC_SKIN_BASE_URL=https://skin.nmo.net.cn

# 本地状态存储目录（保存 Bearer Token 缓存，权限自动设为 0700/0600）
MC_STATE_DIR=.state

# 比赛大模型 API 配置（见 benchmarks/nju-api-20261109/REPORT.md，默认对接比赛 Qwen 接口）
NJU_BASE_URL=https://api.nju-aia.com/v1
NJU_MODEL=default
NJU_API_KEY=
NJU_RPM_BUDGET=24

# 可选：若改用阿里云百炼 DashScope 或其他兼容 Qwen 接口（优先于 NJU_*）
# DASHSCOPE_API_KEY=
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

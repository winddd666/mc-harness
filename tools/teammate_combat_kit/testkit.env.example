# =========================================================
# mc-agent-api v1.3.14 微操与战斗实测配置模板
# =========================================================
# 说明：正式分发的压缩包内已自动附上填好校园网参数与口令的 testkit.env。
# 若需在校外通过 Tailscale 连接，把下面的 10.50.248.70 改为 100.93.211.71 即可。

MC_API_URL=http://10.50.248.70:18900/api/v1

# 注意！严禁填写 BeastBot_01（同角色登录会顶掉控制台/直播正在用的 Bot）
MC_BOT_USER=FightBot_01
MC_BOT_PASS=请填入测试服口令

# RCON（选填：用 --interactive 进服作为 OP 手动放怪实测时无需用到）
RCON_HOST=10.50.248.70
RCON_PORT=25575
RCON_PASS=
